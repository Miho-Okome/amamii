# Google Analytics 4 測定ID（例: G-XXXXXXXXXX）
# TODO: 人間が設定 - Google Analytics でプロパティを作成して取得
NEXT_PUBLIC_GA_ID=

# Google AdSense パブリッシャーID（例: ca-pub-XXXXXXXXXXXXXXXX）
# TODO: 人間が設定 - AdSense申請承認後に取得
NEXT_PUBLIC_ADSENSE_ID=

# Google reCAPTCHA v3 サイトキー（公開用）
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google reCAPTCHA v3 シークレットキー（サーバーサイド用・公開禁止）
RECAPTCHA_SECRET_KEY=

# サイトURL（本番デプロイ時に設定）
NEXT_PUBLIC_SITE_URL=https://your-domain.com
